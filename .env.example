PORT=3000
MONGO_URI=mongodb://localhost:27017/zoffer_bills

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=nomic-embed-text   # always used for the RAG check, regardless of EXTRACTION_PROVIDER

# "ollama" (fully local, default) or "parse" (hosted, needs PARSE_API_KEY below) - see README "Extraction providers"
EXTRACTION_PROVIDER=ollama
PARSE_API_KEY=
PARSE_SCHEMA_ID=

# Zoho Books - must match YOUR account's data center, not guessed.
# Check the URL bar while logged into Zoho Books: .com (US) / .in (India) / .eu / .com.au / ...
# Wrong DC here fails as "invalid_client" and looks identical to a bad secret - see README.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# Single test tenant for this prototype - no real auth/multi-user yet
DEFAULT_ORG_ID=demo-org-1
